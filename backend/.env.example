# ==============================================================================
# EIRENE Backend Environment Template
# Copy this file to .env and configure your local credentials
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Security & JWT (Required: minimum 32-character secret)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRATION=24h

# PostgreSQL Database Configuration (Required)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=eirene_db

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EIRENE <noreply@carehome.com>"

# AWS S3 Cloud Storage & Automated Backups (Required by S3StorageService)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BACKUP_BUCKET=your_s3_bucket_name

# Cloudinary (Optional - Avatar and Document Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (Optional - Push Notifications & Federated Auth)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PayHere Payment Gateway (Optional - Sandbox Mode)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_NOTIFY_URL=http://localhost:3000/api/payments/notify
PAYHERE_RETURN_URL=http://localhost:5173/family/payments/success
PAYHERE_CANCEL_URL=http://localhost:5173/family/payments/cancel
